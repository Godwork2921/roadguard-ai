# =============================================================================
# RoadGuard AI - environment template
# =============================================================================
# Copy to .env and adjust. NEVER commit .env (it is gitignored).
#
#   cp .env.example .env
#
# Docker Compose reads this file automatically when invoked from the repo root.
# Spring Boot and the AI service also read it through the env vars wired in
# docker-compose.yml.
#
# The values below are DEVELOPMENT DEFAULTS ONLY. Several of them are
# deliberately weak so the stack starts with zero setup. Replace every one of
# them before exposing anything beyond localhost.
# =============================================================================

# -----------------------------------------------------------------------------
# Compose behaviour
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=roadguard
# Profiles are opt-in service groups. 'observability' adds Prometheus, Grafana,
# Loki, Tempo and the OpenTelemetry collector.
COMPOSE_PROFILES=

# -----------------------------------------------------------------------------
# PostgreSQL + PostGIS  (durable source of truth)
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=roadguard
POSTGRES_USER=roadguard
# CHANGE: default matches application.yml so `mvn spring-boot:run` works locally.
POSTGRES_PASSWORD=roadguard
# Separate database owned by Keycloak.
KEYCLOAK_DB=keycloak
# Read-only role created by infrastructure/scripts/init-db.sh
READONLY_ROLE=roadguard_readonly
# Host port. Set to 5433 if a local Postgres already occupies 5432.
POSTGRES_HOST_PORT=5432

# -----------------------------------------------------------------------------
# Redis  (live / ephemeral state ONLY - never historical GPS)
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# -----------------------------------------------------------------------------
# Kafka  (asynchronous domain events)
# -----------------------------------------------------------------------------
KAFKA_HOST=kafka
KAFKA_PORT=9092
KAFKA_HOST_PORT=9092
# Single-node KRaft. Multi-broker clusters must override all of these.
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_NODE_ID=1
KAFKA_NUM_PARTITIONS=3
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true

# -----------------------------------------------------------------------------
# Keycloak  (OIDC provider - authoritative identity)
# -----------------------------------------------------------------------------
KEYCLOAK_HOST=keycloak
KEYCLOAK_PORT=8080
KEYCLOAK_HOST_PORT=8081
# Realm imported on first boot from infrastructure/keycloak/roadguard-realm.json
KEYCLOAK_REALM=roadguard
KEYCLOAK_ADMIN=admin
# CHANGE: Keycloak refuses to start in dev mode with the default password.
KEYCLOAK_ADMIN_PASSWORD=admin
# Must match the `aud` claim validated by the resource server (Phase 4).
KEYCLOAK_CLIENT_ID=roadguard-api
KEYCLOAK_AUDIENCE=roadguard-api

# -----------------------------------------------------------------------------
# S3-compatible object storage  (MinIO)
# -----------------------------------------------------------------------------
# Images are configurable: Docker Hub's minio/* repositories are unreachable
# from some networks and have been withdrawn at times. Point S3_IMAGE at a
# mirror, or at any S3-compatible server. The rest of the stack is unaffected
# because `mc` speaks the S3 protocol rather than a vendor-specific API.
MINIO_HOST=minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MINIO_ROOT_USER=roadguard
MINIO_ROOT_PASSWORD=roadguard123
MINIO_BUCKET_HAZARDS=roadguard-hazards
MINIO_BUCKET_AI=roadguard-ai
# Public base URL used to build object references stored in PostgreSQL.
MINIO_PUBLIC_URL=http://localhost:9000
S3_IMAGE=minio/minio:RELEASE.2024-10-13T13-34-11Z
# Startup arguments for S3_IMAGE (MinIO syntax). Servers that do not accept
# `--console-address` need a different value here.
S3_SERVER_ARGS=server /data --console-address ":9001"
# Client used by the one-shot minio-init job to create buckets. The AWS CLI is
# used rather than `mc` because it speaks plain S3 and is not tied to a
# specific server implementation.
S3_INIT_IMAGE=amazon/aws-cli:2.22.15
# How long minio-init waits for the storage endpoint before giving up.
S3_INIT_TIMEOUT=120

# -----------------------------------------------------------------------------
# Backend  (Spring Boot)
# -----------------------------------------------------------------------------
BACKEND_PORT=8080
BACKEND_HOST_PORT=8080
SERVER_PORT=8080
LOG_LEVEL=INFO
# Base64-encoded secret, >= 256 bits. Generate a new one for production:
#   openssl rand -base64 64
# NOTE: superseded by Keycloak in Phase 4; retained for the current JWT flow.
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_64
SPRING_PROFILES_ACTIVE=default

# -----------------------------------------------------------------------------
# AI service  (FastAPI)
# -----------------------------------------------------------------------------
AI_SERVICE_PORT=8000
AI_SERVICE_HOST_PORT=8000
AI_SERVICE_URL=http://ai-service:8000
AI_MODEL_PATH=/app/models/hazard_detection.tflite
AI_CONFIDENCE_THRESHOLD=0.8
AI_LOG_LEVEL=INFO
# Browser origins permitted to call the AI service directly.
AI_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------------------
# Nginx
# -----------------------------------------------------------------------------
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# -----------------------------------------------------------------------------
# External integrations
# -----------------------------------------------------------------------------
# Routing provider abstraction. Swap for a self-hosted OSRM in production.
OSRM_BASE_URL=http://router.project-osrm.org
# Firebase Cloud Messaging (Phase 6). Leave disabled until a real
# service-account key is mounted - never commit the key itself.
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_KEY_PATH=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# -----------------------------------------------------------------------------
# Observability (profile: observability)
# -----------------------------------------------------------------------------
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
LOKI_PORT=3100
TEMPO_PORT=3200
OTEL_COLLECTOR_OTLP_GRPC_PORT=4317
OTEL_COLLECTOR_OTLP_HTTP_PORT=4318
GRAFANA_ADMIN_PASSWORD=admin