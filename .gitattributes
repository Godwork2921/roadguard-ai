# Normalize line endings in the repository; checkout with platform endings.
* text=auto eol=lf

# Windows scripts must keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Lockfiles and generated files: never touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.jar binary
*.zip binary
*.gz binary

# Gradle wrapper must stay binary
*.jar binary

# AI model artifacts
apps/ai/ai-service/models/** binary