# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_size = 4
max_line_length = 120

[*.{kt,kts}]
indent_size = 4
ktlint_official = true
max_line_length = 120

[*.py]
indent_size = 4
max_line_length = 100

[*.{xml,sql}]
indent_size = 2

[*.{yml,yaml,json,jsonc}]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown; do not strip them.
trim_trailing_whitespace = false

[*.{sh,bash}]
indent_size = 2

[*.bat]
end_of_line = crlf

[*.ps1]
end_of_line = crlf

[Makefile]
indent_style = tab

[*.{tf,tfvars}]
indent_size = 2